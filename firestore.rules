rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Site Content & CMS: Publicly readable
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Products Catalog: Publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Categories & Taxonomy: Publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders: Customers can create orders
    match /orders/{orderId} {
      allow create: if request.resource.data != null &&
                       request.resource.data.orderNumber is string;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Customer Profiles: Authenticated users can manage their own profile
    match /customers/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Default fallback: Deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
