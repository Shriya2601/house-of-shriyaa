rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site Content & CMS: Publicly readable; writable for administrative updates
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    // Products Catalog: Publicly readable; administrative catalog management
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.resource.data != null &&
                               request.resource.data.name is string &&
                               request.resource.data.name.size() > 0;
      allow delete: if true;
    }

    // Categories & Taxonomy: Publicly readable; administrative category management
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if request.resource.data != null &&
                               request.resource.data.name is string;
      allow delete: if true;
    }

    // Orders: Anyone (customers) can create orders; administrative and patron tracking
    match /orders/{orderId} {
      allow create: if request.resource.data != null &&
                       request.resource.data.orderNumber is string;
      allow read, update, delete: if true;
    }

    // Admin Credentials & Boutique Settings
    match /admin_settings/{documentId} {
      allow read, write: if true;
    }

    match /admin_auth/{documentId} {
      allow read, write: if true;
    }

    // Admin profiles / metadata
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Uploaded Media & Product Images
    match /uploaded_assets/{assetId} {
      allow read: if true;
      allow create, update: if request.resource.data != null &&
                               (request.resource.data.dataUrl is string || request.resource.data.url is string);
      allow delete: if true;
    }

    // User Accounts & Customer Profiles (readable for patron profiles and administrative management)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{userId} {
      allow read, write: if true;
    }

    // Authentication Audit Logs (secure audit trail for debugging and security audits)
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }

    // Default fallback: Deny all unmatched collections to prevent open database vulnerabilities
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

