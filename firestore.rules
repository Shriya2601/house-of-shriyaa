rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Site Content & CMS: Publicly readable
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Products Catalog: Publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Categories & Taxonomy: Publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Customer Profiles: Registered patrons can read and update their own profile
    match /customers/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Allow fallback create during first sign-up
      allow create: if isSignedIn();

      // Subcollection for user-specific bookings & order receipts
      match /bookings/{bookingId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Orders & Ensemble Bookings: Customers can place orders, track them, and read their own
    match /orders/{orderId} {
      allow create: if request.resource.data != null;
      allow read: if true; // Allows order tracking by order number & customer order history
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.customer.email == request.auth.token.email
      );
    }

    // Atelier & Consultation Bookings: Patrons can book atelier visits and view their appointments
    match /bookings/{bookingId} {
      allow create: if request.resource.data != null;
      allow read: if true; // Allows booking reference verification
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      );
    }

    // Default fallback: Deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
