rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPrimaryAdminEmail() {
      return request.auth.token.email != null &&
             (request.auth.token.email.lower() == "kshriya2626@gmail.com" ||
              request.auth.token.email.lower() == "houseofshriya.in@gmail.com" ||
              request.auth.token.email.lower() == "crochetbyshriya01@gmail.com" ||
              request.auth.token.email.lower() == "shriya14301@gmail.com" ||
              request.auth.token.email.lower() == "shriyapusha01@gmail.com" ||
              request.auth.token.email.lower() == "hello.munchmini@gmail.com" ||
              request.auth.token.email.lower() == "care@houseofshriya.com" ||
              request.auth.token.email.lower() == "admin@houseofshriya.com");
    }

    // Admin Profiles & Roles
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && isPrimaryAdminEmail()) ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Site Content & CMS: Publicly readable; administrative updates require admin role
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products Catalog: Publicly readable; administrative catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories & Taxonomy: Publicly readable; administrative category management
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Anyone (customers) can create orders; administrative tracking restricted to admins
    match /orders/{orderId} {
      allow create: if request.resource.data != null &&
                       request.resource.data.orderNumber is string;
      allow read, update, delete: if isAdmin();
    }

    // Admin Credentials & Boutique Settings
    match /admin_settings/{documentId} {
      allow read, write: if isAdmin();
    }

    match /admin_auth/{documentId} {
      allow read, write: if isAdmin();
    }

    // Uploaded Media & Product Images
    match /uploaded_assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Accounts & Customer Profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /customers/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Authentication Audit Logs (secure audit trail)
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_auth_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default fallback: Deny all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


