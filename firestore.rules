rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default-Deny Catch-All (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Helper Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'houseofshriya.in@gmail.com' ||
        request.auth.token.email == 'houseofshriyaa@gmail.com' ||
        request.auth.token.email == 'admin@houseofshriya.in' ||
        request.auth.token.email == 'kshriya2626@gmail.com' ||
        request.auth.token.email == 'shriyapusha2001@gmail.com' ||
        request.auth.token.email == 'shriyapusha01@gmail.com' ||
        request.auth.token.email == 'shriya14301@gmail.com' ||
        request.auth.token.email == 'ethnicbyshriya@gmail.com' ||
        request.auth.token.email == 'crochetbyshriya01@gmail.com' ||
        request.auth.token.email == 'hello.kohoo@gmail.com' ||
        request.auth.token.email == 'tiarathakur93@gmail.com' ||
        request.auth.token.email == 'hello.munchmini@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Schema Validators
    function isValidSiteContent(data) {
      return data is map &&
        (!('announcementText' in data) || (data.announcementText is string && data.announcementText.size() <= 2000)) &&
        (!('announcementCta' in data) || (data.announcementCta is string && data.announcementCta.size() <= 500)) &&
        (!('announcementVisible' in data) || data.announcementVisible is bool) &&
        (!('heroSlides' in data) || (data.heroSlides is list && data.heroSlides.size() <= 50)) &&
        (!('brandTagline' in data) || (data.brandTagline is string && data.brandTagline.size() <= 2000)) &&
        (!('brandDescription' in data) || (data.brandDescription is string && data.brandDescription.size() <= 5000)) &&
        (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 100));
    }

    function isValidProduct(data) {
      return data is map &&
        (!('name' in data) || (data.name is string && data.name.size() <= 500)) &&
        (!('price' in data) || (data.price is string && data.price.size() <= 100)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 200)) &&
        (!('inStock' in data) || data.inStock is bool) &&
        (!('image' in data) || data.image is string);
    }

    function isValidOrder(data) {
      return data is map &&
        (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 200)) &&
        (!('total' in data) || (data.total is number && data.total >= 0)) &&
        (!('items' in data) || (data.items is list && data.items.size() <= 200));
    }

    function isValidBooking(data) {
      return data is map &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 300)) &&
        (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 300)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 100)) &&
        (!('clientPhone' in data) || (data.clientPhone is string && data.clientPhone.size() <= 100)) &&
        (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 200));
    }

    // 4. Collection Rules

    // Site Content & CMS: Publicly readable; writable by Admin or authorized boutique manager
    match /site_content/{documentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Products Catalog: Publicly readable; managed by Admin
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Categories Taxonomy: Publicly readable; managed by Admin
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Brand Styles & Custom Overrides
    match /brand_styles/{documentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    match /custom_overrides/{documentId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Orders: Customers & Admin
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Atelier Bookings: Patrons & Admin
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Customer Profiles: Patron can read/update own profile; Admin has full access
    match /customers/{userId} {
      allow read, write: if true;

      match /bookings/{bookingId} {
        allow read, write: if true;
      }
    }
  }
}
