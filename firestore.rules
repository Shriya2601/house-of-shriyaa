rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shriya14301@gmail.com' ||
        request.auth.token.email == 'houseofshriya.in@gmail.com' ||
        request.auth.token.email == 'ethnicbyshriya@gmail.com' ||
        request.auth.token.email == 'crochetbyshriya01@gmail.com' ||
        request.auth.token.email == 'hello.kohoo@gmail.com' ||
        request.auth.token.email.matches('(?i)shriya14301@gmail\\.com') ||
        request.auth.token.email.matches('(?i)houseofshriya\\.in@gmail\\.com') ||
        request.auth.token.email.matches('(?i)ethnicbyshriya@gmail\\.com') ||
        request.auth.token.email.matches('(?i)crochetbyshriya01@gmail\\.com') ||
        request.auth.token.email.matches('(?i)hello\\.kohoo@gmail\\.com')
      );
    }

    // Site Content & CMS: Publicly readable and writable for seamless multi-device storefront updates
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if true;
    }

    // Products Catalog: Publicly readable and writable so updates reflect instantly across all phones & devices
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories & Taxonomy: Publicly readable and writable for synchronized navigation
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer Profiles: Registered patrons can read and update their own profile; admin has full access
    match /customers/{userId} {
      allow read, write: if true;

      // Subcollection for user-specific bookings & order receipts
      match /bookings/{bookingId} {
        allow read, write: if true;
      }
    }

    // Orders & Ensemble Bookings: Customers can place orders, track them, and read their own; admin can manage all
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Atelier & Consultation Bookings: Patrons can book atelier visits and view their appointments; admin can manage all
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

