# Shiprocket API Logistics Integration (Server-side)
# Found in Shiprocket Dashboard > Settings > API > Configure API Users
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=

# Registered pickup location nickname in Shiprocket (e.g. "Primary", "Home")
SHIPROCKET_PICKUP_LOCATION=Home

# Firebase Configuration
FIREBASE_API_KEY=
VITE_FIREBASE_API_KEY=
