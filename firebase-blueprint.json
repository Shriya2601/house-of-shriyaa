{
  "entities": {
    "site_content": {
      "title": "Site Content & CMS",
      "description": "Global website editable content including announcement ribbon, hero slides, brand story, atelier details, and footer.",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string", "description": "Announcement bar headline text" },
        "announcementCta": { "type": "string", "description": "Announcement bar CTA text" },
        "announcementVisible": { "type": "boolean", "description": "Whether announcement bar is displayed" },
        "heroSlides": { "type": "array", "description": "List of hero slider banners" },
        "brandTagline": { "type": "string", "description": "Main brand tagline" },
        "brandDescription": { "type": "string", "description": "Brand story and introduction" },
        "contactPhone": { "type": "string", "description": "Atelier contact phone" },
        "contactEmail": { "type": "string", "description": "Customer support email" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp concierge phone number" },
        "featureItems": { "type": "array", "description": "Heritage features listed on storefront" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last CMS update" }
      }
    },
    "products": {
      "title": "Product Catalog",
      "description": "Handcrafted Indian couture and suit catalog items.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product fabric weave description" },
        "color": { "type": "string", "description": "Color name" },
        "colorHex": { "type": "string", "description": "Color hex code for swatch e.g. #0d4f3c" },
        "colorVariants": { "type": "array", "description": "Array of independent color variants with individual images, prices, and fabric details" },
        "rating": { "type": "string", "description": "Customer star rating" },
        "reviews": { "type": "string", "description": "Review count" },
        "price": { "type": "string", "description": "Selling price string e.g. ₹3,899" },
        "originalPrice": { "type": "string", "description": "Original MRP price string e.g. ₹5,499" },
        "savings": { "type": "string", "description": "Savings percent e.g. Save 29%" },
        "badges": { "type": "array", "description": "Tag badges e.g. Bestseller, New Drop" },
        "image": { "type": "string", "description": "Primary high-res image URL" },
        "hoverImage": { "type": "string", "description": "Secondary hover image URL" },
        "images": { "type": "array", "description": "List of product gallery photos" },
        "category": { "type": "string", "description": "Category slug or name" },
        "fabricType": { "type": "string", "description": "Fabric classification" },
        "tags": { "type": "array", "description": "Search and filter tags" },
        "inStock": { "type": "boolean", "description": "Inventory availability status" },
        "sizes": { "type": "array", "description": "Available size options" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      }
    },
    "categories": {
      "title": "Product Categories",
      "description": "Category taxonomy for filtering and navigation.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category display label" },
        "slug": { "type": "string", "description": "URL slug" },
        "description": { "type": "string", "description": "Category description" },
        "itemCount": { "type": "number", "description": "Number of items in category" },
        "sortOrder": { "type": "number", "description": "Display order" }
      }
    },
    "orders": {
      "title": "Customer Orders & Bookings",
      "description": "Orders and couture ensemble bookings placed by customers.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "description": "Unique order reference (e.g. HOS-2026-1001)" },
        "userId": { "type": "string", "description": "Firebase Auth UID of customer who booked" },
        "customer": { "type": "object", "description": "Customer name, email, phone" },
        "shippingAddress": { "type": "object", "description": "Full delivery address, city, state, pincode" },
        "items": { "type": "array", "description": "List of ordered items with quantity, price, size, selected fabric" },
        "subtotal": { "type": "number", "description": "Items subtotal amount in INR" },
        "shippingFee": { "type": "number", "description": "Delivery fee in INR" },
        "total": { "type": "number", "description": "Total order amount in INR" },
        "paymentMethod": { "type": "string", "description": "Payment mode (COD, UPI, Card)" },
        "paymentStatus": { "type": "string", "description": "Payment status (Pending, Paid)" },
        "orderStatus": { "type": "string", "description": "Fulfillment status (pending, confirmed, shipped, delivered, cancelled)" },
        "trackingNumber": { "type": "string", "description": "Courier AWB tracking number" },
        "notes": { "type": "string", "description": "Customer notes" },
        "createdAt": { "type": "string", "description": "Order placement ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Status change ISO timestamp" }
      }
    },
    "customers": {
      "title": "Customer Profiles",
      "description": "Registered patron accounts with personal details, saved shipping addresses, and sizing preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Patron email address" },
        "fullName": { "type": "string", "description": "Patron full name" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "tier": { "type": "string", "description": "Patron loyalty tier (e.g. Gold, Platinum)" },
        "referralCode": { "type": "string", "description": "Customer unique referral share code" },
        "savedAddresses": { "type": "array", "description": "List of saved shipping addresses" },
        "sizingProfile": { "type": "object", "description": "Bespoke sizing and cut preferences" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" },
        "updatedAt": { "type": "string", "description": "Profile update timestamp" }
      }
    },
    "bookings": {
      "title": "Atelier & Consultation Bookings",
      "description": "Private VIP atelier styling appointments, virtual bridal consultations, and fitting bookings.",
      "type": "object",
      "properties": {
        "bookingNumber": { "type": "string", "description": "Unique booking reference number" },
        "userId": { "type": "string", "description": "Firebase Auth UID of customer" },
        "fullName": { "type": "string", "description": "Client full name" },
        "email": { "type": "string", "description": "Client email" },
        "phone": { "type": "string", "description": "Contact phone" },
        "serviceType": { "type": "string", "description": "Type of booking: Atelier Visit, Virtual Drape Consultation, Bespoke Fitting" },
        "preferredDate": { "type": "string", "description": "Preferred appointment date" },
        "preferredTime": { "type": "string", "description": "Preferred appointment time slot" },
        "notes": { "type": "string", "description": "Special styling requirements or attire focus" },
        "status": { "type": "string", "description": "Booking status: confirmed, pending, completed, cancelled" },
        "createdAt": { "type": "string", "description": "Booking creation ISO timestamp" }
      }
    },
    "newsletter_subscriptions": {
      "title": "Newsletter Subscriptions",
      "description": "Email newsletter subscribers who signed up via the website footer.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber email address" },
        "subscribedAt": { "type": "string", "description": "ISO timestamp of subscription" },
        "source": { "type": "string", "description": "Source of subscription (e.g. footer)" },
        "status": { "type": "string", "description": "Subscription status (active, unsubscribed)" }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Products catalog"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Customer orders and ensemble bookings"
    },
    "/bookings/{bookingId}": {
      "schema": "bookings",
      "description": "Private atelier styling and consultation bookings"
    },
    "/customers/{userId}": {
      "schema": "customers",
      "description": "Customer accounts and patron profiles"
    },
    "/customers/{userId}/bookings/{bookingId}": {
      "schema": "bookings",
      "description": "User specific bookings and appointment history"
    },
    "/site_content/{documentId}": {
      "schema": "site_content",
      "description": "Global CMS content"
    },
    "/categories/{categoryId}": {
      "schema": "categories",
      "description": "Product categories"
    },
    "/newsletter_subscriptions/{subscriptionId}": {
      "schema": "newsletter_subscriptions",
      "description": "Newsletter email subscribers list"
    }
  }
}
